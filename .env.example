# ============================================================
# FRONTEND (Vite) — vai EMBARCADO no bundle do navegador.
# Config web do Firebase é pública por design (não é secreto).
# Definir no Vercel como Environment Variables (Production + Preview).
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mededuca-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mededuca-ai
VITE_FIREBASE_STORAGE_BUCKET=mededuca-ai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ============================================================
# BACKEND (Vercel Functions em /api) — SECRETO.
# NUNCA prefixar com VITE_. Só no Vercel env.
# ============================================================
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx

# Service account do Firebase Admin (JSON puro OU base64).
# Firebase Console > Config do projeto > Contas de serviço > Gerar nova chave privada.
FIREBASE_SERVICE_ACCOUNT=

# URL pública (success/cancel do Stripe).
PUBLIC_APP_URL=https://mededuca-ai.vercel.app
